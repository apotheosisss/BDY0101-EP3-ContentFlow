# Copiar a .env y pegar la cadena de conexión de Azure Cosmos DB (API MongoDB)
# Portal Azure > Cosmos DB > Connection strings > Primary connection string
MONGO_URI=mongodb://<cuenta>:<clave>@<cuenta>.mongo.cosmos.azure.com:10255/?ssl=true&replicaSet=globaldb&retrywrites=false&maxIdleTimeMS=120000&appName=@<cuenta>@
MONGO_DB=contentflow
